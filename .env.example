# ─── Band ─────────────────────────────────────────────────────────────────────
# Band Agent API key used by the FastAPI app shell.
# This key creates rooms, recruits Agent 1, and seeds the first @mention.
# Prefer a dedicated app-shell/bridge agent key, not one of the four specialists.
BAND_API_KEY=your_band_agent_api_key_here

# ─── Band Remote Agent Runtime ────────────────────────────────────────────────
# Optional overrides; leave blank for Band/Thenvoi defaults.
THENVOI_WS_URL=
THENVOI_REST_URL=
BAND_WS_URL=
BAND_REST_URL=

# ─── Featherless AI (OpenAI-compatible) ───────────────────────────────────────
# Base URL: https://api.featherless.ai/v1
# Model:    meta-llama/Llama-3.3-70B-Instruct
FEATHERLESS_API_KEY=your_featherless_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Llama-3.3-70B-Instruct
FEATHERLESS_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct

# ─── AIML API (OpenAI-compatible) ─────────────────────────────────────────────
# Base URL per current docs: https://api.aimlapi.com/v1
# Models:   gpt-4o, claude-3-5-sonnet
AIML_API_KEY=your_aiml_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o
AIML_REASONING_MODEL=gpt-4o
AIML_VISION_MODEL=gpt-4o
AIML_VERDICT_MODEL=claude-3-5-sonnet

# ─── Domain Intelligence ──────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_key_here
WHOISJSON_KEY=your_whoisjson_key_here

# Temporarily disabled by default; set true and add a key when available.
ENABLE_SAFE_BROWSING=false
GOOGLE_SAFE_BROWSING_KEY=

# ─── Reddit (PRAW) — temporarily disabled by default ──────────────────────────
# Register your app at: https://www.reddit.com/prefs/apps
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PayGuardAI/1.0 by /u/your_username

# ─── Application ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./payguard.db
SECRET_KEY=generate_a_random_32_char_string_here
APP_PORT=8000

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" when recording the demo video to use pre-cached API responses.
# Run scripts/populate_demo_cache.py ONCE first to populate data/demo_cache.json.
USE_DEMO_CACHE=false
